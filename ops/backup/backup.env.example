# Install as /etc/erp-ledger-backup/backup.env with mode 0600 after review.
# Values are literals; shell expansion is not supported. Do not store passwords here.
DATABASE=erp_ledger
MYSQL_CONTAINER=
# Protected client option file INSIDE the MySQL container, mode 0600.
MYSQL_CLIENT_CNF=/run/secrets/backup-client.cnf
PRIMARY_DIR=
SECONDARY_DIR=
SECONDARY_MOUNT=
SECONDARY_UUID=
STATE_DIR=/var/lib/erp-ledger-backup
MIN_FREE_BYTES=1073741824
DAILY_DAYS=30
WEEKLY_WEEKS=12
# Optional reviewed executable on this server. Receives a sanitized status file path.
NOTIFY_HOOK=
